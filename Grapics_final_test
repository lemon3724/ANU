// 1. 프레임 업데이트 시 호출 (회전각 계산 및 상수 버퍼 갱신)
void Update()
{
    m_angle += 0.02f; // 회전 속도
    
    // Z축 기준 회전 행렬 생성
    XMMATRIX rotation = XMMatrixRotationZ(m_angle);
    
    // DX12는 기본적으로 Row-Major 연산을 처리하므로 Transpose하여 셰이더로 복사
    m_cbData.transform = XMMatrixTranspose(rotation);
    
    // Map-Unmap 방식을 통해 GPU 메모리에 업로드
    memcpy(m_pCbvDataBegin, &m_cbData, sizeof(m_cbData));
}

// 2. 프레임 렌더링 시 호출 (Command 작성)
void Render()
{
    // 커맨드 리스트 할당자 및 리스트 초기화 후 파이프라인 상태(PSO) 세팅 생략...
    
    // 셰이더에 전달할 상수 버퍼 힙 설정
    ID3D12DescriptorHeap* heaps[] = { m_cbvHeap };
    m_commandList->SetDescriptorHeaps(_countof(heaps), heaps);
    
